# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI Model Selection
# Options: gpt-5-mini (default, cheaper), gpt-4-turbo-preview, gpt-4, gpt-3.5-turbo
# OPENAI_MODEL=gpt-5-mini

# Optional: Maximum tokens per batch
# Default: 30000 for gpt-5-mini (smaller context window)
# Use 100000 for gpt-4-turbo-preview or gpt-4
# Reduce if hitting context length errors
# MAX_TOKENS_PER_BATCH=30000

# Optional: Include archived tickets (default: false)
# INCLUDE_ARCHIVED=false
